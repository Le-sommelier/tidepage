diff --git a/crates/engine/src/page_range.rs b/crates/engine/src/page_range.rs
new file mode 100644
index 00000000..84b1c4bc
--- /dev/null
+++ b/crates/engine/src/page_range.rs
@@ -0,0 +1,41 @@
+//! The pages a typed range ("1-3, 6, 9-") names, for merging and splitting files. With the `print`
+//! feature this is `pdfcraft_print::select_pages`; without it, the same grammar for plain numbers
+//! (no page labels, no odd/even subset), with the same wording for its errors.
+
+/// The 0-based pages `range` names in a document of `count` pages, in the order typed; a range
+/// written backwards (`5-2`) runs backwards.
+#[cfg(feature = "print")]
+pub(crate) fn select(count: usize, range: &str) -> Result<Vec<usize>, String> {
+    pdfcraft_print::select_pages(count, Some(range), &[], pdfcraft_print::Subset::All, false).map_err(|e| e.to_string())
+}
+
+#[cfg(not(feature = "print"))]
+pub(crate) fn select(count: usize, range: &str) -> Result<Vec<usize>, String> {
+    let page = |tok: &str| -> Result<usize, String> {
+        let t = tok.trim();
+        match t.parse::<usize>() {
+            Ok(n) if n >= 1 && n <= count => Ok(n - 1),
+            Ok(n) => Err(format!("page {n} is out of range (1–{count})")),
+            Err(_) => Err(format!("{t:?} is not a page number or label")),
+        }
+    };
+    let mut pages = Vec::new();
+    for part in range.split([',', ';']).map(str::trim).filter(|p| !p.is_empty()) {
+        match part.split_once('-') {
+            Some((a, b)) => {
+                let from = if a.trim().is_empty() { 0 } else { page(a)? };
+                let to = if b.trim().is_empty() { count.checked_sub(1).ok_or("there are no pages to print")? } else { page(b)? };
+                if from <= to {
+                    pages.extend(from..=to);
+                } else {
+                    pages.extend((to..=from).rev());
+                }
+            }
+            None => pages.push(page(part)?),
+        }
+    }
+    if pages.is_empty() {
+        return Err("there are no pages to print".into());
+    }
+    Ok(pages)
+}
