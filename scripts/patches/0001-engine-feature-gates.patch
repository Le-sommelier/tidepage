diff --git a/crates/engine/src/sign_off.rs b/crates/engine/src/sign_off.rs
new file mode 100644
index 00000000..50df5694
--- /dev/null
+++ b/crates/engine/src/sign_off.rs
@@ -0,0 +1,62 @@
+//! Stand-ins for the `pdfcraft-sign` items the rest of the engine names, compiled when the `sign`
+//! feature is off. Nothing is verified, drawn or signed. A signed file is still recognised (a
+//! dictionary with a `/ByteRange` and a `/Contents` string), so the guards that refuse to
+//! rewrite a signed file, and `Document::is_signed`, keep working.
+
+use pdfcraft_cos::{Dict, Document};
+
+/// A signature found in the file. Its state is always unknown.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct SignatureInfo {
+    pub field: String,
+    pub signed: bool,
+    pub revision: usize,
+    pub status: Status,
+    pub verdict_shown: bool,
+}
+
+/// What a signature's check came to; without the `sign` feature nothing is checked.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Status {
+    #[default]
+    Unknown,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct TrustStore;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct StatusCaptions;
+
+#[derive(Debug, Default)]
+pub struct DigestCache;
+
+fn signed(doc: &Document, d: &Dict) -> bool {
+    d.contains(b"ByteRange") && d.get(b"Contents").is_some_and(|c| doc.resolve(c).as_string().is_some())
+}
+
+pub fn has_status_layers(_doc: &Document, _signatures: &[SignatureInfo]) -> bool {
+    false
+}
+
+pub fn show_status_layers(_doc: &mut Document, _signatures: &mut [SignatureInfo], _captions: &StatusCaptions) -> bool {
+    false
+}
+
+pub mod pdf {
+    use super::{DigestCache, SignatureInfo, TrustStore, signed};
+    use pdfcraft_cos::Document;
+
+    /// The signed signature dictionaries of `doc`, as unchecked entries.
+    pub fn list_cached(doc: &Document, _bytes: &[u8], _trust: &TrustStore, _cache: &DigestCache) -> Vec<SignatureInfo> {
+        doc.scan_objects()
+            .filter(|(_, o)| o.as_dict().is_some_and(|d| signed(doc, d)))
+            .enumerate()
+            .map(|(i, _)| SignatureInfo { signed: true, revision: i + 1, ..SignatureInfo::default() })
+            .collect()
+    }
+
+    pub fn list(doc: &Document, bytes: &[u8], trust: &TrustStore) -> Vec<SignatureInfo> {
+        list_cached(doc, bytes, trust, &DigestCache)
+    }
+}
